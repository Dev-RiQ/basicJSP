<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="kr.basic.mybatis.MemberMapper">
	<select id="getMemberList" resultType="member">
		SELECT * FROM member
	</select>
	
	<select id="getAMemberByNum" parameterType="int" resultType="member">
		SELECT * 
		FROM member 
		WHERE num=${num}
	</select>
	
	<select id="hasId" resultType="int" parameterType="String">
		select num 
		from member 
		where id="${id}"
	</select>
	
	<select id="isLoginPass" parameterType="Member" resultType="int">
		select num 
		from member 
		where id="${id}" and pass="${pass}"
	</select>
	
	<insert id="insertAMember" parameterType="Member" >
		insert into member(id,pass,name,age,email,phone) 
		values("${id}","${pass}","${name}",${age},"${email}","${phone}")
	</insert>
	
	<update id="updateAMemberByNum" parameterType="Member">
		update member 
		set age=${age}, email="${email}", phone="${phone}"
		where num=${num}
	</update>
	
	<delete id="deleteAMemberByNum" parameterType="int">
		delete from member 
		where num=${num}
	</delete>
</mapper>